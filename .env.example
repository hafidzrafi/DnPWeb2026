# Application Configuration
APP_NAME=web-dev
APP_ENV=local
APP_DEBUG=true

# Web Server & Tooling Ports (Host Ports)
HTTP_PORT=80
ADMINER_PORT=8080

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# User & Group ID (Matches Host User on macOS/Linux)
UID=1000
GID=1000
